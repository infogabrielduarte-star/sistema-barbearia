# Conexão com o PostgreSQL (próprio, Neon ou Supabase → Project Settings → Database → Connection string)
DATABASE_URL=postgres://usuario:senha@host:5432/barbearia
# Desative o SSL só em banco local
DATABASE_SSL=true
PORT=3000
NODE_ENV=production
# Desenvolvimento sem instalar o driver pg: usa o psql da máquina
# DB_DRIVER=psql
